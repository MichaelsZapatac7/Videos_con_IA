# YouTube Pipeline — API Keys
# Copy this file to .env and fill in your real keys

# Required
ANTHROPIC_API_KEY=sk-ant-...          # https://console.anthropic.com
ELEVENLABS_API_KEY=sk_...             # https://elevenlabs.io/app/settings/api-keys
PEXELS_API_KEY=...                    # https://www.pexels.com/api/ (free)

# Optional — for AI-generated clips instead of stock
HIGGSFIELD_API_KEY=...                # https://higgsfield.ai

# Channel branding
CHANNEL_NAME=@mzcshard
PRIMARY_COLOR=#FF6B35
SECONDARY_COLOR=#1A1A2E

# ElevenLabs voice (find IDs at https://elevenlabs.io/voice-library)
# Requiere cuenta con créditos (plan Creator o superior).
ELEVENLABS_VOICE_ID=94zOad0g7T7K4oa7zhDq
