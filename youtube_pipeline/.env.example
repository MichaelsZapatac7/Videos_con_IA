# YouTube Pipeline — API Keys
# Copy this file to .env and fill in your real keys

# Required
ANTHROPIC_API_KEY=sk-ant-...          # https://console.anthropic.com
ELEVENLABS_API_KEY=sk_...             # https://elevenlabs.io/app/settings/api-keys
PEXELS_API_KEY=...                    # https://www.pexels.com/api/ (free)

# Optional — for AI-generated clips instead of stock
HIGGSFIELD_API_KEY=...                # https://higgsfield.ai

# Channel branding
CHANNEL_NAME=@mzcshard
PRIMARY_COLOR=#FF6B35
SECONDARY_COLOR=#1A1A2E

# ElevenLabs voice (find IDs at https://elevenlabs.io/voice-library)
# Default: Rachel (multilingual)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ── Proveedor de voz ─────────────────────────────────────────────────────────
# "elevenlabs" = API de pago (por defecto). "local" = tu voz clonada, gratis.
TTS_PROVIDER=elevenlabs

# Voz local (solo si TTS_PROVIDER=local). Ver SETUP_VOZ_LOCAL.md
LOCAL_VOICE_SAMPLE=youtube_pipeline/assets/voces/mi_voz.wav
LOCAL_TTS_LANGUAGE=es
LOCAL_TTS_DEVICE=cuda
# LOCAL_TTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
